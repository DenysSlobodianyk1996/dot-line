{
  "name": "dots-and-boxes-connected",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint-check": "oxlint . && eslint .",
    "format": "prettier --write --experimental-cli src/",
    "generate-icons": "node scripts/generate-icons.ts",
    "store:screenshots": "node scripts/store-screenshots.ts",
    "build:capacitor": "vite build --mode capacitor",
    "android:build": "npm run build:capacitor && cap sync android && cd android && ./gradlew bundleRelease",
    "android:apk": "bash scripts/android-debug-apk.sh",
    "android:install": "bash scripts/android-debug-apk.sh --install",
    "android:open": "cap open android",
    "android:assets": "capacitor-assets generate --android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capawesome/capacitor-app-update": "^8.1.1",
    "@fontsource-variable/nunito": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vee-validate/rules": "^4.15.1",
    "pinia": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.73.0",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "npm-run-all2": "^9.0.2",
    "oxlint": "^1.73.0",
    "playwright": "^1.65.1",
    "png-to-ico": "^3.0.2",
    "prettier": "3.9.5",
    "sass-embedded": "^1.100.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
